---
const teamMembers = [
  {
    name: 'Sofia Amorim',
    role: 'Gerente do projeto',
    image: '',
    color: '#800A22'
  },
  {
    name: 'Nicoli Lima',
    role: 'Frontend do projeto',
    image: '',
    color: '#F2A4B8'
  },
  {
    name: 'Grazielly Oliveira',
    role: 'Backend do projeto',
    image: '',
    color: '#331B14'
  },
  {
    name: 'Maria Luiza Alves',
    role: 'BDA',
    image: '',
    color: '#fcdbb0'
  }
];
---

<section id="depoimentos" class="team-section">
  <div class="team-container">
    
    <!-- Cabeçalho Interativo da Seção -->
    <div class="section-header" id="teamHeaderInteractive">
      <span class="section-subtitle">
        <span class="dot"></span> CONHEÇA QUEM SOMOS
      </span>

      <h2 class="section-title">
        <span class="word">Nossa</span> 
        <span class="word highlight">equipe</span>
      </h2>

      <p class="section-description">
        Veja nosso time responsável pelo Sublime
      </p>
    </div>

    <!-- Círculos da Equipe Interativos -->
    <div class="team-grid">
      {teamMembers.map((member) => (
        <div class="team-member-card">
          <div class="circle-avatar" style={`border-color: ${member.color}; background-color: ${member.color};`}>
            {member.image ? (
              <img src={member.image} alt={member.name} loading="lazy" />
            ) : (
              <span class="avatar-initials">{member.name.charAt(0)}</span>
            )}
          </div>
          <div class="member-info">
            <h3 class="member-name">{member.name}</h3>
            <span class="member-role">{member.role}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .team-section {
    padding: 96px 24px;
    background-color: var(--cor-fundo, #ebe2dc);
    perspective: 1000px;
  }

  .team-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* CABEÇALHO INTERATIVO */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px auto;
    cursor: default;
    user-select: none;
    transform-style: preserve-3d;
    transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* SUBTÍTULO INTERATIVO */
  .section-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #B28374;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 6px 16px;
    border-radius: 50px;
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(178, 131, 116, 0.2);
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .section-subtitle .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #B28374;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .section-header:hover .section-subtitle {
    letter-spacing: 2.5px;
    color: #3A141A;
    background-color: #ffffff;
    border-color: #3A141A;
    box-shadow: 0 4px 15px rgba(58, 20, 26, 0.12);
    transform: translateY(-2px) scale(1.03);
  }

  .section-header:hover .section-subtitle .dot {
    background-color: #3A141A;
    transform: scale(1.4);
  }

  /* TÍTULO PRINCIPAL INTERATIVO */
  .section-title {
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 52px;
    font-weight: 400;
    color: var(--cor-principal, #3A141A);
    margin-bottom: 16px;
    line-height: 1.15;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-title .word {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.3s ease, text-shadow 0.3s ease;
  }

  .section-title .word:hover {
    transform: translateY(-4px) scale(1.08) rotate(-1deg);
    color: #522027;
    text-shadow: 0 8px 20px rgba(82, 32, 39, 0.2);
  }

  .section-description {
    color: var(--cor-texto-secundario, #6B5255);
    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  .section-header:hover .section-description {
    color: #3A141A;
  }

  /* GRID DOS AVATARES E TEXTOS DOS MEMBROS */
  .team-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .team-member-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    padding: 12px;
    border-radius: 20px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .circle-avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid transparent;
    box-shadow: 0 10px 25px rgba(58, 20, 26, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
  }

  .circle-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .avatar-initials {
    color: #ffffff;
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 42px;
    font-weight: 700;
    user-select: none;
  }

  /* INTERATIVIDADE NOS CARDS DE MEMBROS E SEUS TEXTOS */
  .team-member-card:hover {
    transform: translateY(-8px);
    background-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 15px 30px rgba(58, 20, 26, 0.08);
  }

  .team-member-card:hover .circle-avatar {
    transform: scale(1.05);
    box-shadow: 0 15px 35px rgba(58, 20, 26, 0.2);
  }

  .team-member-card:hover .circle-avatar img {
    transform: scale(1.12);
  }

  /* TEXTOS DOS MEMBROS INTERATIVOS */
  .member-info {
    text-align: center;
    transition: transform 0.3s ease;
  }

  .member-name {
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--cor-principal, #3A141A);
    margin: 0;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .team-member-card:hover .member-name {
    color: #522027;
    transform: scale(1.05);
  }

  .member-role {
    font-size: 13px;
    color: var(--cor-texto-secundario, #6B5255);
    display: block;
    margin-top: 2px;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .team-member-card:hover .member-role {
    color: #3A141A;
    font-weight: 500;
  }
</style>

<!-- SCRIPT DE INTERATIVIDADE PARALLAX -->
<script>
  function setupTeamHeaderEffects() {
    const header = document.getElementById('teamHeaderInteractive');

    if (header) {
      header.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = header.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((centerY - y) / centerY) * 6;
        const rotateY = ((x - centerX) / centerX) * 6;

        header.style.transform = `rotateX(${-rotateX}deg) rotateY(${rotateY}deg)`;
      });

      header.addEventListener('mouseleave', () => {
        header.style.transition = 'transform 0.5s ease';
        header.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });

      header.addEventListener('mouseenter', () => {
        header.style.transition = 'none';
      });
    }
  }

  document.addEventListener('astro:page-load', setupTeamHeaderEffects);
  setupTeamHeaderEffects();
</script>