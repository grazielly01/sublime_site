---
const faqItems = [
  {
    question: 'O Sublime funciona no celular?',
    answer: 'Sim! A nossa plataforma é 100% responsiva. Você pode lançar pedidos, verificar o estoque e gerenciar o financeiro diretamente do smartphone, tablet ou computador, de qualquer lugar.'
  },
  {
    question: 'Posso cancelar ou alterar meu plano quando quiser?',
    answer: 'Com certeza. Não exigimos contratos de fidelidade. Você pode assinar hoje, atualizar ou rebaixar seu plano, ou cancelar diretamente pelo painel a qualquer momento, sem taxas ocultas.'
  },
  {
    question: 'Como funciona o cálculo de ficha técnica de receitas?',
    answer: 'Você insere os ingredientes, quantidades e rendimento. Nosso sistema busca automaticamente o custo médio dos itens cadastrados no seu almoxarifado para calcular instantaneamente o custo exato e sugerir preços.'
  },
  {
    question: 'Meus dados de clientes e receitas estão seguros?',
    answer: 'Totalmente. Utilizamos servidores com criptografia de ponta e backups diários automáticos para garantir que suas receitas autorais e histórico financeiro permaneçam estritamente privados.'
  }
];
---

<section id="faq" class="faq-section">
  <div class="faq-container">
    
    <!-- COLUNA DA ESQUERDA: Títulos & Card Suporte -->
    <div class="faq-info-col">
      <span class="section-subtitle">TIRE SUAS DÚVIDAS</span>
      <h2 class="section-title">Dúvidas comuns sobre a Sublime</h2>
      <p class="section-description">
        Se você ainda tem dúvidas sobre como a nossa solução pode se encaixar na sua rotina, fale conosco diretamente pelo suporte.
      </p>

      <!-- Card do WhatsApp -->
      <div class="support-card">
        <h3 class="support-title">Ainda tem alguma pergunta?</h3>
        <p class="support-text">Fale com nossa equipe técnica pelo WhatsApp oficial de suporte.</p>
        <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="btn-support">
          Iniciar conversa
        </a>
      </div>
    </div>

    <!-- COLUNA DA DIREITA: Acordeão Dinâmico -->
    <div class="faq-accordion-col">
      {faqItems.map((item, index) => (
        <div class="faq-item" data-index={index}>
          <button class="faq-question" aria-expanded="false">
            <span>{item.question}</span>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-section {
    padding: 96px 24px;
    background-color: var(--cor-fundo, #ebe2dc);
  }

  .faq-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .faq-container {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* COLUNA DA ESQUERDA */
  .faq-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #B28374;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 48px;
    font-weight: 400;
    color: var(--cor-principal, #3A141A);
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .section-description {
    color: var(--cor-texto-secundario, #6B5255);
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* CARD SUPORTE WHATSAPP */
  .support-card {
    width: 100%;
    background-color: #FAF4F0;
    border: 1px solid var(--cor-borda, #EFE2DA);
    border-radius: 20px;
    padding: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .support-title {
    font-family: var(--fonte-corpo, sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: var(--cor-principal, #3A141A);
    margin: 0;
  }

  .support-text {
    font-size: 13px;
    color: var(--cor-texto-secundario, #6B5255);
    line-height: 1.5;
    margin: 0;
  }

  .btn-support {
    display: inline-block;
    background-color: var(--cor-principal, #3A141A);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-top: 4px;
  }

  .btn-support:hover {
    background-color: #522027;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(58, 20, 26, 0.2);
  }

  /* COLUNA DA DIREITA: ACORDEÃO */
  .faq-accordion-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .faq-item {
    border-bottom: 1px solid var(--cor-borda, #EFE2DA);
    padding-bottom: 16px;
    transition: all 0.3s ease;
  }

  .faq-question {
    width: 100%;
    background: none;
    border: none;
    outline: none;
    padding: 12px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    font-family: var(--fonte-corpo, sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: var(--cor-principal, #3A141A);
    transition: color 0.25s ease;
  }

  .faq-question:hover {
    color: #9E5745;
  }

  .arrow-icon {
    width: 20px;
    height: 20px;
    color: var(--cor-principal, #3A141A);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .faq-item.active .arrow-icon {
    transform: rotate(180deg);
    color: #9E5745;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0, 1, 0, 1), opacity 0.3s ease;
    opacity: 0;
  }

  .faq-item.active .faq-answer {
    max-height: 300px;
    opacity: 1;
    transition: max-height 0.35s cubic-bezier(1, 0, 1, 0), opacity 0.3s ease;
  }

  .faq-answer p {
    font-size: 14px;
    color: var(--cor-texto-secundario, #6B5255);
    line-height: 1.6;
    margin: 8px 0 12px 0;
  }
</style>

<!-- SCRIPT DE INTERATIVIDADE DO ACORDEÃO -->
<script>
  function setupFaqAccordion() {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach((item) => {
      const button = item.querySelector('.faq-question');

      if (button) {
        button.addEventListener('click', () => {
          const isActive = item.classList.contains('active');

          // Fecha todos os outros itens
          faqItems.forEach((otherItem) => {
            otherItem.classList.remove('active');
            const otherBtn = otherItem.querySelector('.faq-question');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          });

          // Se não estava ativo, abre
          if (!isActive) {
            item.classList.add('active');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      }
    });
  }

  document.addEventListener('astro:page-load', setupFaqAccordion);
  setupFaqAccordion();
</script>