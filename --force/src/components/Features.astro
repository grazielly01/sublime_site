---

<section id="funcionalidades" class="features-section">
  
  <!-- TRANSIÇÃO 1: Curva fluida SVG no topo da seção -->
  <div class="curve-divider">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,32L80,42.7C160,53,320,75,480,80C640,85,800,75,960,58.7C1120,43,1280,21,1360,10.7L1440,0L1440,120L0,120Z" fill="#FAF7F2"></path>
    </svg>
  </div>

  <!-- TRANSIÇÃO 2: Esfera de luz difusa em tom rosado para dar destaque -->
  <div class="bg-glow"></div>

  <div class="features-container">
    
    <!-- Cabeçalho -->
    <div class="features-header reveal-item">
      <span class="features-subtitle">TUDO SOB CONTROLE</span>
      <h2 class="features-title">O ingrediente secreto para crescer</h2>
      <p class="features-description">
        Esqueça planilhas confusas e cadernos rasgados. A Sublime centraliza toda a operação da sua cozinha e atendimento em um painel elegante e fácil de usar.
      </p>
    </div>

    <!-- Grid de Cards com Revelação Animada -->
    <div class="features-grid">
      {features.map((f, index) => (
        <div class="feature-card reveal-item" style={`--delay: ${index * 0.1}s;`}>
          <div class="card-header">
            <div class="icon-wrapper">
              <svg class="icon-svg" viewBox="0 0 24 24" Fragment set:html={f.icon} />
            </div>
            {f.tag && <span class="badge">{f.tag}</span>}
          </div>

          <h3 class="card-title">{f.title}</h3>
          <p class="card-text">{f.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.features-section {
  position: relative;
  padding: 80px 24px;
  background-color: transparent; /* Permite que a cor de fundo seja contínua */
}

  /* Divisor em Onda de Transição */
  .curve-divider {
    position: absolute;
    top: -60px;
    left: 0;
    width: 100%;
    height: 60px;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
  }

  .curve-divider svg {
    position: relative;
    display: block;
    width: 100%;
    height: 60px;
  }

  /* Brilho Ambiente de Fundo (Glow Effect) */
  .bg-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(232, 206, 191, 0.35) 0%, rgba(250, 247, 242, 0) 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .features-container {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 60px auto;
  }

  .features-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #C08474;
    display: block;
    margin-bottom: 12px;
  }

  .features-title {
    font-size: 2.25rem;
    font-family: serif;
    font-weight: 700;
    color: #3B1E1E;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .features-description {
    color: #8C7A70;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  /* Cards com sombras suaves e transição */
  .feature-card {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid #F0E6DE;
    border-radius: 24px;
    padding: 28px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .feature-card:hover {
    transform: translateY(-8px) scale(1.01);
    border-color: #E8CEBF;
    box-shadow: 0 20px 40px rgba(59, 30, 30, 0.07);
    background-color: #ffffff;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background-color: #F9ECE6;
    color: #3B1E1E;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .feature-card:hover .icon-wrapper {
    background-color: #3B1E1E;
    color: #ffffff;
    transform: scale(1.08);
  }

  .icon-svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
  }

  .badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #9E5745;
    background-color: #F8E3DC;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .card-title {
    font-size: 1.25rem;
    font-family: serif;
    font-weight: 700;
    color: #3B1E1E;
    margin-bottom: 10px;
    transition: color 0.3s ease;
  }

  .feature-card:hover .card-title {
    color: #9E5745;
  }

  .card-text {
    color: #7A6B62;
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  /* TRANSIÇÃO 3: Animação Scroll Reveal com IntersectionObserver */
  .reveal-item {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease var(--delay, 0s), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0s);
  }

  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Animação ao rolar a página com JavaScript Puro
  function initScrollReveal() {
    const items = document.querySelectorAll('.reveal-item');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.15
    });

    items.forEach((item) => observer.observe(item));
  }

  document.addEventListener('astro:page-load', initScrollReveal);
  initScrollReveal();
</script>