---

import SublimeLogo from '../assets/Sublime_logo.png';
---

<!-- SEÇÃO CTA FINAL + RODAPÉ (FOOTER) -->
<footer class="footer-section">
  
  <!-- BANNER PRINCIPAL -->
  <div class="cta-container">
    <div class="cta-header" id="ctaHeaderInteractive">
      <span class="cta-subtitle">CRIE SUA CONTA GRÁTIS HOJE</span>

      <h2 class="cta-title">
        Transforme a sua confeitaria em um negócio profissional
      </h2>

      <p class="cta-description">
        Aumente a sua margem de lucro real e otimize o seu tempo. Junte-se a milhares de doceiras de sucesso.
      </p>

      <div class="cta-botoes">
        <a href="#cadastro" class="btn-cta-primary">Experimentar Grátis</a>
        <a href="#demonstracao" class="btn-cta-secondary">Agendar Demo</a>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <!-- CONTEÚDO DO RODAPÉ (LINKS & MARCA) -->
  <div class="footer-container">
    <div class="footer-grid">
      
      <!-- COLUNA DA MARCA -->
      <div class="brand-col">
        <div class="footer-logo">
          <div class="logo-circulo-footer">
            <img src={SublimeLogo.src} alt="Sublime Logo" class="logo-foto" />
          </div>
          <span class="brand-name">Sublime</span>
        </div>
        <p class="brand-description">
          O Sistema Inteligente de gestão financeira, produção e estoque desenhado especificamente para confeitarias artesanais.
        </p>
      </div>

      <!-- COLUNAS DE LINKS -->
      <div class="links-group">
        
        <div class="link-col">
          <h4 class="col-title">PRODUTO</h4>
          <ul>
            <li><a href="#funcionalidades">Funcionalidades</a></li>
            <li><a href="#como-funciona">Como funciona</a></li>
            <li><a href="#preco">Preços</a></li>
            <li><a href="#faq">Suporte</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">EMPRESA</h4>
          <ul>
            <li><a href="#depoimentos">Sobre nós</a></li>
            <li><a href="#">Blog das Confeiteiras</a></li>
            <li><a href="#">Carreiras</a></li>
            <li><a href="#">Contato</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">LEGAL</h4>
          <ul>
            <li><a href="#">Políticas de Privacidade</a></li>
            <li><a href="#">Termos de Uso</a></li>
            <li><a href="#">Segurança dos Dados</a></li>
          </ul>
        </div>

      </div>

    </div>

    <!-- DIREITOS AUTORAIS & REDES SOCIAIS -->
    <div class="footer-bottom">
      <p class="copyright">
        © 2026 Sublime Software. Todos os direitos reservados.
      </p>

      <div class="social-links">
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="#" aria-label="Twitter">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
        </a>
        <a href="#" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
      </div>
    </div>

  </div>

</footer>

<style>
  .footer-section {
    background-color: #3A141A; /* Burgundy escuro do protótipo */
    color: #FAF7F2;
    padding-top: 80px;
    padding-bottom: 40px;
  }

  /* CTA CONTAINER */
  .cta-container {
    max-width: 900px;
    margin: 0 auto 64px auto;
    padding: 0 24px;
    text-align: center;
  }

  .cta-subtitle {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #E29A9A;
    text-transform: uppercase;
    display: inline-block;
    padding: 6px 16px;
    border-radius: 50px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(226, 154, 154, 0.2);
    margin-bottom: 20px;
  }

  .cta-title {
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 48px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  @media (max-width: 640px) {
    .cta-title { font-size: 36px; }
  }

  .cta-description {
    font-size: 15px;
    color: rgba(250, 247, 242, 0.75);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 32px auto;
  }

  .cta-botoes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-cta-primary {
    background-color: #ffffff;
    color: #3A141A;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .btn-cta-primary:hover {
    background-color: #FAF7F2;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .btn-cta-secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.25s ease;
  }

  .btn-cta-secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .footer-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    max-width: 1200px;
    margin: 0 auto 64px auto;
  }

  /* RODAPÉ E LINKS */
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    margin-bottom: 64px;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-circulo-footer {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-name {
    font-family: var(--fonte-titulo, 'Instrument Serif', serif);
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
  }

  .brand-description {
    font-size: 13px;
    color: rgba(250, 247, 242, 0.65);
    line-height: 1.6;
    max-width: 340px;
  }

  .links-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 540px) {
    .links-group {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #E29A9A;
    margin-bottom: 16px;
  }

  .link-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .link-col a {
    color: rgba(250, 247, 242, 0.7);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .link-col a:hover {
    color: #ffffff;
  }

  /* BOTTOM BAR */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    gap: 24px;
    flex-wrap: wrap;
  }

  .copyright {
    font-size: 12px;
    color: rgba(250, 247, 242, 0.5);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-links a {
    color: rgba(250, 247, 242, 0.6);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .social-links svg {
    width: 18px;
    height: 18px;
  }

  .social-links a:hover {
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>