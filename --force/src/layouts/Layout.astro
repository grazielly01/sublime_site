---
interface Props {
	title: string;
}

const { title } = Astro.props;

// IMPORTAÇÃO MANUAL DO SEU CSS:
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
